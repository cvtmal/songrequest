#!/usr/bin/env bash
# Deploys origin/main on the pre-launch host (cyon). Runs ON the server: the
# GitHub Actions deploy key is locked to this script via authorized_keys.
# Wrapped in main() because `git pull` may rewrite this file while it runs;
# bash parses the whole function before executing it.
set -euo pipefail

main() {
    local php=php85
    local composer="$HOME/bin/composer.phar"

    cd "$(dirname "$(readlink -f "$0")")/.."

    # cache:clear regenerates this reference file with prod-only bundles; drop
    # that change so the pull can fast-forward.
    git checkout -- config/reference.php

    git pull --ff-only origin main
    echo "Deploying $(git log --oneline -1)"

    # Runs cache:clear, assets:install and importmap:install via auto-scripts.
    "$php" "$composer" install --no-dev --optimize-autoloader --no-interaction --no-progress
    "$php" bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
    "$php" bin/console asset-map:compile
    "$php" bin/console cache:clear

    git checkout -- config/reference.php
    echo "DEPLOYED_SHA=$(git rev-parse HEAD)"
}

main "$@"
exit
