{% extends 'base.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}

{% block title %}{{ 'dj.home.page_title'|trans({dj: dj}) }}{% endblock %}

{% block body %}
    <main class="page page-wide">
        <div class="page-head">
            <div class="page-title">
                <div class="page-sub">{{ dj }}</div>
                <h1 class="display">{{ 'dj.home.heading'|trans({dj: dj}) }}</h1>
            </div>
            <a class="btn btn-primary btn-pill" href="{{ path('event_new') }}">{{ icons.icon('plus', 15) }}{{ 'dj.home.new_event'|trans }}</a>
        </div>

        {% if active is empty and closed is empty %}
            <p class="empty">{{ 'dj.home.empty'|trans }}</p>
        {% endif %}

        {% if active is not empty %}
            <section class="list list-active">
                <h6 class="section-label">{{ 'dj.home.active'|trans }}</h6>
                {% for event in active %}
                    <div class="list-row list-row-stacked" data-event-id="{{ event.id }}">
                        <div class="card-head">
                            <div class="list-row-title">{{ event.name }}</div>
                            <span class="tag {{ event.status == 'open' ? 'tag-accent' : 'tag-neutral' }}">{{ ('dj.events.status.' ~ event.status)|trans }}</span>
                        </div>
                        <div class="btn-row">
                            <a class="btn btn-primary" href="{{ path('event_queue', {id: event.id}) }}">{{ 'dj.home.queue'|trans }}</a>
                            <a class="btn btn-secondary" href="{{ path('event_qr', {id: event.id}) }}">{{ 'dj.home.qr'|trans }}</a>
                            <form method="post" action="{{ path('event_close', {id: event.id}) }}"
                                data-turbo-confirm="{{ 'dj.home.close_confirm'|trans({name: event.name}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('event_close') }}">
                                <button type="submit" class="btn btn-secondary">{{ 'dj.home.close'|trans }}</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </section>
        {% endif %}

        {% if closed is not empty %}
            <section class="list list-closed">
                <h6 class="section-label">{{ 'dj.home.closed'|trans }}</h6>
                {% for event in closed %}
                    <div class="list-row" data-event-id="{{ event.id }}">
                        <div class="list-row-main">
                            <div class="list-row-title is-past">{{ event.name }}</div>
                        </div>
                        <span class="tag tag-neutral">{{ 'dj.events.status.closed'|trans }}</span>
                        <a class="btn btn-secondary" href="{{ path('event_queue', {id: event.id}) }}">{{ 'dj.home.queue'|trans }}</a>
                        <a class="btn btn-secondary" href="{{ path('event_qr', {id: event.id}) }}">{{ 'dj.home.qr'|trans }}</a>
                    </div>
                {% endfor %}
            </section>
        {% endif %}

        <a class="btn btn-ghost btn-touch btn-start" href="{{ path('guest_blocks') }}">{{ 'dj.home.blocks'|trans }}</a>

        <form method="post" action="{{ logout_path() }}" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="btn btn-secondary btn-touch">{{ 'dj.home.logout'|trans }}</button>
        </form>
    </main>
{% endblock %}
